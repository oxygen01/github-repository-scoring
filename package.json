{
  "name": "github-repository-scoring",
  "version": "1.0.0",
  "description": "Backend application for scoring repositories on GitHub",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint:prettier": "prettier --log-level warn --check src/**/*.ts",
    "lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint src/**/*.ts",
    "lint:ts": "tsc --pretty --noEmit --incremental",
    "lint": "run-p lint:eslint lint:ts lint:prettier",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format:eslint": "eslint --fix src/**/*.ts",
    "format:prettier": "prettier --write src/**/*.ts",
    "format": "run-s format:eslint format:prettier",
    "test": "jest",
    "test:watch": "jest --watch",
    "benchmark": "ts-node  src/benchmarks/run-benchmarks.ts"
  },
  "keywords": [
    "github",
    "repository",
    "scoring",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "node-cache": "^5.1.2",
    "octokit": "^3.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@octokit/types": "^12.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/node-cache": "^4.2.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
